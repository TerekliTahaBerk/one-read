{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/verify-build-provenance.mjs && next build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 16 * * 1,3,5"
    }
  ]
}
