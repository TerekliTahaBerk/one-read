# Public URLs
PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# PostgreSQL
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Email
RESEND_API_KEY=""
RESEND_FROM="OneRead <hello@oneread.email>"
RESEND_REPLY_TO="hello@oneread.email"
RESEND_WEBHOOK_SECRET=""
EMAIL_VERIFICATION_SECRET=""

# Billing
BILLING_PROVIDER="polar"
# Compiles and serves the dev/test mock billing surface (fake checkout, fake
# portal). On by default in local development. Set to "true" only on a preview
# deployment that needs the fixture flow. It has NO effect in production — the
# mock routes are not built there and the mock helpers refuse to write. See the
# "Production route surface" section of the README.
MOCK_BILLING_PREVIEW="false"
POLAR_SERVER="production"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ONEREAD_PRODUCT_ID=""
POLAR_ONEREAD_RETURN_URL="http://localhost:3000/subscribe"
POLAR_ONEREAD_SUCCESS_URL="http://localhost:3000/subscribe/success?checkout_id={CHECKOUT_ID}"
ONEREAD_PRICE_MONTHLY="1"
ONEREAD_BILLING_LABEL="$1 / month"

# Admin and cron
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_ADDITIONAL_ACCOUNTS="[]"
ADMIN_SESSION_SECRET=""
ADMIN_MUTATIONS_ENABLED="true"
ADMIN_SEND_ACTIONS_ENABLED="true"
CRON_SECRET=""
ONE_ARTICLE_CRON_ENABLED="false"
ONE_ARTICLE_DRY_RUN="true"
ONE_ARTICLE_REQUIRE_APPROVAL="true"
# Error monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional editorial assistance
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL_FAST=""
GEMINI_MODEL_QUALITY=""
